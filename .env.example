# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Route marketplace)
# key_id is returned to the browser by /api/checkout/create-order at runtime.
# Do NOT add a NEXT_PUBLIC_ copy: public vars are inlined at build time, so a
# key rotation without a rebuild would mismatch the key against the order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# AES-256-GCM key for seller bank details (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this makes stored bank account numbers unrecoverable.
ENCRYPTION_KEY=

# TEST ONLY — run checkout without Razorpay Route splits, so the order flow can
# be exercised before Route is activated on the merchant account.
# When true, Sakdha collects the full amount and seller payouts become a MANUAL
# obligation (the ledger still records what is owed).
# Ignored unless RAZORPAY_KEY_ID is a test key (rzp_test_*), so it cannot take
# effect in production. Leave unset in any real deployment.
SAKDHA_ALLOW_UNSPLIT_CHECKOUT=

# The apex the platform runs on, e.g. "sakdha.com". Every store is addressed as
# <slug>.<this>, so it decides which host is the platform and which is a tenant
# storefront. Unset falls back to "localhost", which is what makes
# <slug>.localhost:3100 work in dev without touching the hosts file — correct
# locally, wrong anywhere else, and it fails silently by serving the platform
# for every host.
NEXT_PUBLIC_ROOT_DOMAIN=

# Dev-only logins for scripts/check-finance-isolation.mjs. Set these to the
# passwords of the seeded test accounts; the script refuses to run without
# them rather than falling back to anything.
TEST_STORE_A_OWNER_PASSWORD=
TEST_STORE_B_OWNER_PASSWORD=
TEST_CUSTOMER_PASSWORD=
